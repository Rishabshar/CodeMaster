# --- Critical Secrets ---
# Ignores .env in the root and in the Backend folder
.env
**/.env
.env.local
.env.*.local

# --- Dependencies ---
# Ignores node_modules everywhere (root and Backend)
node_modules/
**/node_modules/

# --- Build & Output ---
dist/
**/dist/
dist-ssr/
*.local

# --- Logs ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Editor & OS Files ---
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Database & Temp ---
# Ignores local database files if you use SQLite or temp dumps
*.sqlite
*.db